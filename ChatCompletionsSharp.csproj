<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>ChatCompletionsSharp</PackageId>
    <Version>1.0.0</Version>
    <Authors>SeaSharpy</Authors>
    <Description>A stylish alternative to the official OpenAI sdk.</Description>
    <PackageTags>utility library openai ai api</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NJsonSchema" Version="11.4.0" />
    <PackageReference Include="NJsonSchema.NewtonsoftJson" Version="11.4.0" />
  </ItemGroup>
</Project>
